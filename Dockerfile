# Используем официальный образ Node.js версии 22.14.0
FROM node:22.14.0

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы package.json и package-lock.json внутрь контейнера
COPY package.json package-lock.json ./

# Устанавливаем зависимости проекта
RUN npm ci

# Копируем все остальные файлы проекта внутрь контейнера
COPY . .

#добавляем команду, которая будет запускаться при старте контейнера
CMD ["npm", "start"]

